{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GG77 Launcher",
  "version": "0.5.0",
  "identifier": "com.gg77studios.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GG77 Launcher",
        "width": 1320,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Biblioteca, perfil e conquistas dos jogos do grupo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "GG77 Studios",
    "copyright": "GG77 Studios",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "PortugueseBR"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3ODQwMjEzNTI2Nzg2NUYKUldSZmhtZFNFd0tFeDdqb1JCSVhwZEY4N0VhMGFNQ2JTZnA2Y2R6L1lRSi8yWHp1am9jSnhraG4K",
      "endpoints": [
        "https://github.com/gg77studios/gg77-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
